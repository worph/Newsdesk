# Development image: dependencies baked in, source bind-mounted at run time.
# Dependencies are installed here rather than on the host so the native
# better-sqlite3 binding matches the container's platform, not yours.
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY server/package.json server/
COPY web/package.json web/
RUN npm ci --no-audit --no-fund

# The compose file bind-mounts the repo over /app and keeps this node_modules
# alive with an anonymous volume.
CMD ["npm", "run", "dev", "--workspace", "server"]
